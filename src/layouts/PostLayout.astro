---
import BaseLayout from "./BaseLayout.astro";
import type { Props as BaseProps } from "./BaseLayout.astro";

export interface Props extends BaseProps {
  date?: Date;
  readingTime?: string;
  tags?: string[];
}

const {
  title = "Untitled Post",
  description = "",
  date,
  readingTime,
  tags = [],
  image = "/og-default.png",
  url = "https://scottrobbins.ai",
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  url={url}
  type="article"
>
  <article class="prose mx-auto max-w-3xl">
    <!-- Post header -->
    <header class="mb-10 not-prose">
      <h1 class="font-['Playfair_Display',Georgia,serif] text-3xl font-bold leading-tight text-[var(--color-text)] sm:text-4xl">
        {title}
      </h1>

      {description && (
        <p class="mt-4 text-lg text-[var(--color-text-muted)]">
          {description}
        </p>
      )}

      <!-- Meta: date, reading time, tags -->
      <div class="mt-6 flex flex-wrap items-center gap-4 text-sm text-[var(--color-text-dim)]">
        {date && (
          <time datetime={date.toISOString()}>
            {date.toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })}
          </time>
        )}

        {readingTime && (
          <span class="flex items-center gap-1">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            {readingTime}
          </span>
        )}
      </div>

      <!-- Tags -->
      {tags.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <a
              href={`/blog/tags/${tag.toLowerCase().replace(/\s+/g, "-")}`}
              class="rounded-full bg-[var(--color-accent-subtle)] px-3 py-1 text-xs font-medium text-[var(--color-accent)] transition-colors hover:bg-[var(--color-accent)] hover:text-white"
            >
              #{tag}
            </a>
          ))}
        </div>
      )}
    </header>

    <!-- Post content -->
    <slot />
  </article>
</BaseLayout>