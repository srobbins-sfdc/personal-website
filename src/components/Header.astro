---
export interface Props {
  title?: string;
}

const { title = "Scott Robbins" } = Astro.props;
---

<header
  class="sticky top-0 z-50 w-full"
  id="site-header"
>
  <!-- Glass-effect backdrop -->
  <div
    class="glass absolute inset-0 -z-10"
    aria-hidden="true"
  ></div>

  <nav
    class="vx-container flex items-center justify-between py-4"
    aria-label="Main navigation"
  >
    <!-- Brand -->
    <a
      href="/"
      class="brand"
    >
      {title}
    </a>

    <!-- Desktop nav links -->
    <ul
      class="nav hidden items-center gap-7 md:flex"
      role="list"
    >
      <li><a href="/projects">Projects</a></li>
      <li><a href="/posts">Blog</a></li>
      <li><a href="/resume">Resume</a></li>
      <li><a href="/contact">Contact</a></li>
    </ul>

    <!-- Right side: search trigger + dark mode toggle + hamburger -->
    <div class="flex items-center gap-3">
      <!-- Search trigger -->
      <button
        id="search-toggle"
        class="flex h-9 w-9 items-center justify-center rounded-lg transition-colors hover:bg-[var(--vx-pill)]"
        style="color: var(--vx-text);"
        aria-label="Open search"
        type="button"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8" />
          <path d="m21 21-4.35-4.35" />
        </svg>
      </button>

      <!-- Dark mode toggle -->
      <div id="dark-toggle-slot"></div>

      <!-- Mobile hamburger -->
      <button
        id="hamburger-btn"
        class="flex h-9 w-9 items-center justify-center rounded-lg md:hidden"
        style="color: var(--vx-text);"
        aria-label="Toggle menu"
        aria-expanded="false"
        type="button"
      >
        <svg id="hamburger-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu panel -->
  <div
    id="mobile-menu"
    class="glass hidden px-5 pb-4 md:hidden"
    role="navigation"
    aria-label="Mobile navigation"
  >
    <ul class="flex flex-col gap-1" role="list">
      <li><a href="/projects" class="block rounded-lg px-3 py-2 text-sm font-bold uppercase tracking-wide" style="color: var(--vx-navy);">Projects</a></li>
      <li><a href="/posts" class="block rounded-lg px-3 py-2 text-sm font-bold uppercase tracking-wide" style="color: var(--vx-navy);">Blog</a></li>
      <li><a href="/resume" class="block rounded-lg px-3 py-2 text-sm font-bold uppercase tracking-wide" style="color: var(--vx-navy);">Resume</a></li>
      <li><a href="/contact" class="block rounded-lg px-3 py-2 text-sm font-bold uppercase tracking-wide" style="color: var(--vx-navy);">Contact</a></li>
    </ul>
  </div>
</header>

<script>
  const hamburgerBtn = document.getElementById("hamburger-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  const hamburgerIcon = document.getElementById("hamburger-icon");

  hamburgerBtn?.addEventListener("click", () => {
    const isOpen = mobileMenu?.classList.toggle("hidden");
    hamburgerBtn?.setAttribute("aria-expanded", String(!isOpen));

    if (hamburgerIcon) {
      if (mobileMenu?.classList.contains("hidden")) {
        hamburgerIcon.innerHTML = `
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        `;
      } else {
        hamburgerIcon.innerHTML = `
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        `;
      }
    }
  });

  mobileMenu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      mobileMenu.classList.add("hidden");
      hamburgerBtn?.setAttribute("aria-expanded", "false");
      if (hamburgerIcon) {
        hamburgerIcon.innerHTML = `
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        `;
      }
    });
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && mobileMenu && !mobileMenu.classList.contains("hidden")) {
      mobileMenu.classList.add("hidden");
      hamburgerBtn?.setAttribute("aria-expanded", "false");
    }
  });
</script>
