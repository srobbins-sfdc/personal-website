---
import BaseLayout from "../layouts/BaseLayout.astro";

interface UsesCategory {
  name: string;
  items: Array<{
    name: string;
    description: string;
    url?: string;
  }>;
}

const categories: UsesCategory[] = [
  {
    name: "Hardware",
    items: [
      { name: "MacBook Pro M3 Max", description: "64 GB RAM, 1 TB SSD — my daily driver for development and AI workloads." },
      { name: "LG 27\" 4K Monitor", description: "Primary external display, USB-C connected for clean desk setup." },
      { name: "Keychron Q1 Pro", description: "Mechanical keyboard with Gateron Brown switches, QMK/VIA programmable." },
      { name: "Logitech MX Master 3S", description: "Ergonomic mouse with customizable buttons and silent clicks." },
      { name: "AirPods Pro 2", description: "Noise cancellation for deep focus sessions and calls." },
    ],
  },
  {
    name: "Development",
    items: [
      { name: "VS Code", description: "Primary editor with Vim keybindings, GitHub Copilot, and custom snippets." },
      { name: "Neovim", description: "Quick edits and terminal-based development when I need to stay in the shell." },
      { name: "Warp", description: "Modern terminal with AI-powered command suggestions and GPU acceleration." },
      { name: "iTerm2", description: "Fallback terminal with tmux integration for remote sessions." },
      { name: "GitHub CLI", description: "Everything from the command line — PRs, issues, actions, and code review." },
    ],
  },
  {
    name: "AI & ML Tools",
    items: [
      { name: "Hermes Agent", description: "My own AI assistant framework — dogfooding what I build." },
      { name: "Claude Code", description: "AI-powered terminal agent for complex coding tasks and refactoring." },
      { name: "vLLM", description: "High-throughput LLM inference server for local and cloud model serving." },
      { name: "Hugging Face", description: "Model hub, datasets, and Spaces for experimentation and sharing." },
      { name: "Weights & Biases", description: "Experiment tracking, model registry, and dataset versioning." },
    ],
  },
  {
    name: "Productivity",
    items: [
      { name: "Obsidian", description: "Knowledge management with backlinks, graph view, and community plugins." },
      { name: "Linear", description: "Issue tracking and project management — fast, keyboard-first, and delightful." },
      { name: "Notion", description: "Team wikis, meeting notes, and collaborative documentation." },
      { name: "Arc Browser", description: "Chromium-based browser with vertical tabs, profiles, and spaces." },
      { name: "Raycast", description: "macOS launcher and productivity tool — extensions, clipboard, and window management." },
    ],
  },
  {
    name: "Audio & Media",
    items: [
      { name: "Spotify", description: "Lo-fi beats, ambient soundscapes, and focus playlists for coding sessions." },
      { name: "OBS Studio", description: "Screen recording and streaming for demos and tutorials." },
      { name: "Pocket Casts", description: "Podcast player for tech, AI, and software engineering shows." },
    ],
  },
];
---

<BaseLayout title="Uses — Scott Robbins" description="The gear, software, and tools I use daily.">
  <section class="section">
    <div class="mx-auto max-w-3xl">
      <h1 class="font-display text-3xl font-bold leading-tight text-[var(--color-text)] sm:text-4xl">
        /uses
      </h1>
      <p class="mt-4 text-lg text-[var(--color-text-muted)]">
        A curated list of the hardware, software, and tools I use daily. Inspired by
        {" "}<a href="https://uses.tech" class="text-[var(--color-accent)] underline decoration-transparent transition-colors hover:decoration-[var(--color-accent)]">uses.tech</a>.
      </p>

      <div class="mt-12 space-y-12">
        {categories.map((category) => (
          <section>
            <h2 class="font-display text-2xl font-bold text-[var(--color-text)]">
              {category.name}
            </h2>
            <div class="mt-6 space-y-6">
              {category.items.map((item) => (
                <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-surface-alt)] p-5 transition-all duration-200 hover:border-[var(--color-accent-subtle)]">
                  <div class="flex items-start justify-between gap-4">
                    <div>
                      <h3 class="font-display text-lg font-semibold text-[var(--color-text)]">
                        {item.name}
                      </h3>
                      <p class="mt-1 text-sm leading-relaxed text-[var(--color-text-muted)]">
                        {item.description}
                      </p>
                    </div>
                    {item.url && (
                      <a
                        href={item.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="shrink-0 text-[var(--color-text-dim)] transition-colors hover:text-[var(--color-accent)]"
                        aria-label={`${item.name} website`}
                      >
                        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                        </svg>
                      </a>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>