---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Message Sent — Scott Robbins" description="Your message has been sent.">
  <section class="section">
    <div class="vx-container">
      <div style="max-width: 600px; margin: 0 auto; text-align: center;">
        <div style="display:inline-flex; align-items:center; justify-content:center; width:80px; height:80px; border-radius:50%; background: #d1fae5; margin-bottom: 32px;">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
        </div>
        <h1 class="hero-title" style="font-size: clamp(32px, 4vw, 48px);">
          Message <span class="accent">Sent</span>
        </h1>
        <p class="hero-copy" style="max-width: 480px; margin: 24px auto 0;">
          Thanks for reaching out! I'll get back to you soon.
        </p>
        <div style="margin-top: 40px;">
          <a href="/" class="btn btn-primary">Back Home</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
