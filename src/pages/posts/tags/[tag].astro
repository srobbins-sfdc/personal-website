---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PostCard from "../../../components/PostCard.astro";
import type { GetStaticPathsResult } from "astro";

export async function getStaticPaths(): Promise<GetStaticPathsResult> {
  // In production, query all posts and extract unique tags
  const tags = ["ai", "engineering", "web-dev", "devops", "open-source", "career", "tutorial"];
  return tags.map((tag) => ({ params: { tag } }));
}

const { tag } = Astro.params;

const tagDisplay = tag
  ? tag
      .split("-")
      .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
      .join(" ")
  : "";

// Hardcoded filtered posts for the current tag
const allPosts = [
  { title: "Building AI Agents That Actually Work", description: "Lessons learned from building production-grade AI agents.", date: new Date("2026-06-15"), tags: ["AI", "Engineering"], url: "/posts/building-ai-agents", image: "" },
  { title: "Scaling LLM Inference with vLLM", description: "A practical guide to deploying LLMs in production.", date: new Date("2026-04-10"), tags: ["AI", "DevOps"], url: "/posts/scaling-llm-inference", image: "" },
  { title: "The Art of Prompt Engineering", description: "Systematic approaches to crafting prompts for LLMs.", date: new Date("2026-03-05"), tags: ["AI", "Tutorial"], url: "/posts/art-of-prompt-engineering", image: "" },
  { title: "Why I Switched to Astro for My Personal Site", description: "Why Astro won out over Next.js and Hugo.", date: new Date("2026-05-20"), tags: ["Web Dev"], url: "/posts/why-astro", image: "" },
  { title: "Containerization Best Practices for ML Workloads", description: "Efficient Docker images for ML.", date: new Date("2026-02-18"), tags: ["DevOps", "Engineering"], url: "/posts/containerization-ml", image: "" },
  { title: "Open Source Lessons Learned", description: "What maintaining open source projects taught me.", date: new Date("2026-01-22"), tags: ["Open Source", "Career"], url: "/posts/open-source-lessons", image: "" },
];

const filteredPosts = allPosts.filter(
  (post) => post.tags.map((t) => t.toLowerCase().replace(/\s+/g, "-")).includes(tag ?? "")
);
---

<BaseLayout title={`${tagDisplay} Posts — Scott Robbins`} description={`Posts tagged with ${tagDisplay}.`}>
  <section class="section">
    <div class="mx-auto max-w-5xl">
      <!-- Breadcrumb -->
      <nav class="mb-6 flex items-center gap-2 text-sm text-[var(--color-text-dim)]">
        <a href="/posts" class="hover:text-[var(--color-accent)] transition-colors">Posts</a>
        <span>/</span>
        <span class="text-[var(--color-text-muted)]">{tagDisplay}</span>
      </nav>

      <h1 class="font-display text-3xl font-bold leading-tight text-[var(--color-text)] sm:text-4xl">
        Posts tagged &ldquo;{tagDisplay}&rdquo;
      </h1>
      <p class="mt-2 text-[var(--color-text-muted)]">
        {filteredPosts.length} {filteredPosts.length === 1 ? "post" : "posts"}
      </p>

      {filteredPosts.length > 0 ? (
        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {filteredPosts.map((post) => (
            <PostCard
              title={post.title}
              description={post.description}
              date={post.date}
              tags={post.tags}
              url={post.url}
              image={post.image || undefined}
            />
          ))}
        </div>
      ) : (
        <div class="mt-10 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface-alt)] p-10 text-center">
          <p class="text-[var(--color-text-muted)]">
            No posts tagged &ldquo;{tagDisplay}&rdquo; yet. Check back soon!
          </p>
          <a
            href="/posts"
            class="mt-4 inline-block text-sm font-medium text-[var(--color-accent)] hover:text-[var(--color-accent-hover)]"
          >
            View all posts &rarr;
          </a>
        </div>
      )}
    </div>
  </section>
</BaseLayout>