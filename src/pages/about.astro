---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About — Scott Robbins" description="Learn more about Scott Robbins, his background, skills, and what drives him.">
  <section class="section section-muted">
    <div class="vx-container">
      <div style="display:flex; flex-direction:column; gap: 40px; align-items:flex-start;">
        <!-- Headshot + intro -->
        <div style="display:flex; flex-direction:column; gap: 32px; align-items:flex-start;" class="about-intro">
          <div>
            <img
              src="/images/placeholder-headshot.svg"
              alt="Scott Robbins"
              width="200"
              height="200"
              style="border-radius: var(--vx-radius-md); border: 1px solid var(--vx-border); object-fit: cover; width: 200px; height: 200px;"
            />
          </div>
          <div style="flex:1;">
            <span class="eyebrow" style="margin-bottom: 20px; display:inline-flex;">
              About Me
            </span>
            <h1 class="hero-title" style="font-size: clamp(36px, 4vw, 54px); margin: 20px 0 24px;">
              Scott <span class="accent">Robbins</span>
            </h1>
            <p class="hero-copy" style="max-width: 600px;">
              Principal Data &amp; AI Architect at Salesforce, Global D360 team. 15+ Salesforce
              certifications, AWS and Google Cloud credentials. Deep vertical expertise in
              manufacturing, automotive, and energy.
            </p>
            <p class="hero-copy" style="max-width: 600px; font-size: 16px;">
              Based in Michigan. When I&rsquo;m not architecting Data Cloud and Agentforce solutions,
              I&rsquo;m writing about AI, tinkering with watches and EDC gear, skiing cross-country,
              and working on my home gym and DIY electrical projects.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Skills -->
  <section class="section">
    <div class="vx-container">
      <div class="section-heading" style="text-align:left; margin-bottom: 50px;">
        <h2 class="section-title">Skills &amp; Expertise</h2>
      </div>

      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>
            </svg>
          </div>
          <h3>Data Cloud &amp; Agentforce</h3>
          <p>Salesforce Data Cloud, Agentforce, Einstein AI, and the broader Data &amp; AI go-to-market motion.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
          </div>
          <h3>Cloud Architecture</h3>
          <p>AWS and GCP infrastructure, serverless patterns, IAM, Pub/Sub, and multi-cloud deployment strategies.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M16 18l6-6-6-6"/><path d="M8 6l-6 6 6 6"/>
            </svg>
          </div>
          <h3>Vertical Expertise</h3>
          <p>Manufacturing, automotive, and energy — domain-specific solutions and industry cloud patterns.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M9 11H1l8-8 8 8h-8v8a4 4 0 004 4h8"/>
            </svg>
          </div>
          <h3>AI &amp; Automation</h3>
          <p>Agent orchestration, RAG pipelines, model evaluation, and production-grade AI system design.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
